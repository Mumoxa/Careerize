{
  "name": "careerize",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "validate:catalog": "node scripts/validateCatalog.mjs",
    "validate:foundation": "node scripts/validateSaFoundation.mjs",
    "validate:production": "node scripts/validateProductionReadiness.mjs",
    "validate:recommendations": "node scripts/validateRecommendationScenarios.mjs",
    "validate:recommendation-matrix": "node scripts/validateRecommendationMatrix.mjs",
    "export:qualification-coverage": "node scripts/exportQualificationCoverage.mjs",
    "export:career-research-queue": "node scripts/exportCareerResearchQueue.mjs",
    "export:research-team-workplan": "node scripts/exportResearchTeamWorkplan.mjs",
    "test:ui": "vitest run",
    "smoke:browser": "node scripts/smokeBrowser.mjs",
    "test:e2e": "npm run smoke:browser",
    "test": "npm run validate:catalog && npm run validate:foundation && npm run validate:production && npm run validate:recommendations && npm run validate:recommendation-matrix && npm run test:ui",
    "check": "npm run export:qualification-coverage && npm run export:career-research-queue && npm run export:research-team-workplan && npm run validate:catalog && npm run validate:foundation && npm run validate:production && npm run validate:recommendations && npm run validate:recommendation-matrix && npm run test:ui && npm run build && npm run smoke:browser",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
